rules_version = '2';

// Regras do Cloud Firestore do projeto ACADÊMICO terae-app-academico
// (Dispositivos Móveis, UNEMAT 2026; Atividade 4, D12). Não é o Terae produção.
//
// Sem Cloud Functions (plano Spark), o servidor que a Atividade 3 previa é
// substituído por estas regras: elas conferem quem lê e grava cada documento
// e garantem, no próprio servidor, o que o aparelho não pode decidir sozinho
// (D18): o código de convite é de uso único, o paciente só se liga à conta
// que usou o código no mesmo lote, no máximo dois cuidadores ativos (§7.4),
// o cuidador lê só as cópias reduzidas (RNFM05; a exceção declarada é a
// resposta de presença da F2, abaixo), alerta só nasce de registro
// grave ou crítico e nada é apagado (§23).
//
// Publicar: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{db}/documents {

    function logado() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function paciente(pid) {
      return get(/databases/$(db)/documents/pacientes/$(pid)).data;
    }

    function pacienteDepois(pid) {
      return getAfter(/databases/$(db)/documents/pacientes/$(pid)).data;
    }

    function ehTitular(pid) {
      return logado() && paciente(pid).contaId == uid();
    }

    function ehCuidador(pid) {
      return logado() && uid() in paciente(pid).cuidadoresAtivos;
    }

    function soMudam(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    // O convite [codigo] do paciente [pid] e do [tipo] estava em aberto e
    // passa a usado neste mesmo lote.
    function conviteUsadoNoLote(codigo, pid, tipo) {
      let antes = get(/databases/$(db)/documents/convites/$(codigo)).data;
      let depois = getAfter(/databases/$(db)/documents/convites/$(codigo)).data;
      return antes.pacienteId == pid && antes.tipo == tipo
        && antes.usadoEm == null && depois.usadoEm != null
        && !antes.get('revogado', false);
    }

    // ------------------------------------------------------------- contas
    match /contas/{conta} {
      allow read: if logado() && uid() == conta;
      allow create: if logado() && uid() == conta
        && request.resource.data.id == conta
        && request.resource.data.situacao == 'ativa';
      // A própria pessoa atualiza nome, último acesso; a situação é da clínica.
      allow update: if logado() && uid() == conta
        && soMudam(['nomeExibicao', 'ultimoAcessoEm', 'email']);
      allow delete: if false;
    }

    match /profissionais/{id} {
      allow read: if logado();
    }

    // ----------------------------------------------------------- convites
    // O primeiro acesso confere o código antes de haver conta: o documento
    // não tem CPF nem nascimento, só o hash (cpfHash, nascimentoHash).
    match /convites/{codigo} {
      allow get: if true;
      allow list: if false;
      allow create: if logado()
        && request.resource.data.tipo == 'cuidador'
        && request.resource.data.codigo == codigo
        && request.resource.data.usadoEm == null
        && ehTitular(request.resource.data.pacienteId);
      allow update: if logado() && (
        (resource.data.usadoEm == null && soMudam(['usadoEm']))
        || (ehTitular(resource.data.pacienteId) && soMudam(['revogado']))
      );
      allow delete: if false;
    }

    // ---------------------------------------------------------- pacientes
    match /pacientes/{pid} {
      allow get: if ehTitular(pid) || ehCuidador(pid);
      allow list: if logado()
        && (resource.data.contaId == uid() || uid() in resource.data.cuidadoresAtivos);

      // Ativação (TM09): liga a conta pelo código usado no mesmo lote.
      // Cuidador (TM10): entra em cuidadoresAtivos pelo convite usado, no
      // máximo dois (§7.4). Revogar (TM07): o titular tira da lista.
      allow update: if logado() && (
        (resource.data.contaId == null
          && request.resource.data.contaId == uid()
          && soMudam(['contaId', 'ativadoPorConvite'])
          && conviteUsadoNoLote(request.resource.data.ativadoPorConvite, pid, 'paciente'))
        || (soMudam(['cuidadoresAtivos', 'ativadoPorConvite'])
          && request.resource.data.cuidadoresAtivos.size() <= 2
          && (ehTitular(pid)
            || (request.resource.data.cuidadoresAtivos.toSet()
                  .difference(resource.data.cuidadoresAtivos.toSet()) == [uid()].toSet()
                && conviteUsadoNoLote(request.resource.data.ativadoPorConvite, pid, 'cuidador'))))
      );
      allow create, delete: if false;

      // CPF e nascimento: só o titular.
      match /privado/{documento} {
        allow read: if ehTitular(pid);
      }

      // Item principal (D13), o diário igual ao do portal (P3, D17 revista):
      // só a adesão é obrigatória; corrigir cria a versão seguinte e guarda a
      // anterior; retirar marca a data e o motivo. Nada é apagado, e só a
      // clínica marca a revisão (revisadoEm).
      match /registros/{rid} {
        function textoDoDiario(campo) {
          let valor = request.resource.data.get(campo, null);
          return valor == null || (valor is string && valor.size() <= 2000);
        }

        function registroValido() {
          let d = request.resource.data;
          return d.id == rid
            && d.pacienteId == pid
            && d.situacaoEnvio == 'enviado'
            && d.adesao in ['total', 'parcial', 'nenhuma']
            && d.get('intensidadeSintoma', null) in [null, 'leve', 'moderado', 'grave', 'critico']
            && textoDoDiario('sintomas')
            && textoDoDiario('observacoes')
            && d.versao is int
            && d.versoesAnteriores is list
            && d.versoesAnteriores.size() == d.versao - 1
            && d.get('revisadoEm', null) == null;
        }

        function retiradaValida() {
          let m = request.resource.data.motivoDaRetirada;
          return request.resource.data.retiradoEm is string
            && m.categoria in ['dia_errado', 'paciente_errado', 'enviado_sem_querer', 'outro']
            && (m.categoria != 'outro'
              || (m.detalhe is string && m.detalhe.size() > 0 && m.detalhe.size() <= 300));
        }

        allow read: if ehTitular(pid);
        allow create: if ehTitular(pid) && registroValido()
          && request.resource.data.versao == 1;
        function podeMudar() {
          return resource.data.get('revisadoEm', null) == null
            && resource.data.get('retiradoEm', null) == null
            && !resource.data.get('alertouAEquipe', false);
        }

        // O documento das A3–A5 (sem `versao`): o aparelho que atualizou o
        // app reenvia a correção ou a exclusão que ainda estava na fila, já
        // no formato novo (D39). A semente nova (`--reiniciar`) apaga esses
        // documentos; isto cobre o Firebase antes dela.
        function doFormatoAntigo() {
          return !('versao' in resource.data);
        }

        // Revisão da P4 (M3): o documento antigo não tem `alertouAEquipe`;
        // o alerta dele (D18) nascia de "grave" ou "critica" no campo antigo
        // `intensidade`. Por segurança, esse não muda mais (como o 409).
        function antigoQuePodeTerAlertado() {
          return resource.data.get('intensidade', '') in ['grave', 'critica'];
        }

        // Corrigir: a versão seguinte, com as anteriores intactas e o mesmo
        // primeiro recebimento (R04: nada se perde).
        function versaoSeguinte() {
          let d = request.resource.data;
          let anteriores = resource.data.get('versoesAnteriores', []);
          return d.versao == resource.data.get('versao', 1) + 1
            // O recorte [0:0] dá erro de índice nas regras: a primeira
            // correção (sem anteriores) não compara nada.
            && (anteriores.size() == 0
              || d.versoesAnteriores[0:anteriores.size()] == anteriores)
            && d.get('enviadoEm', null) == resource.data.get('enviadoEm', null)
            && d.get('retiradoEm', null) == null;
        }

        // O 409 do portal: o revisado, o retirado e o que avisou a equipe não
        // mudam mais. Mudam: a versão seguinte (corrigir) e a retirada com
        // motivo. O reenvio da fila que já tinha chegado (o lote que estourou
        // o prazo e gravou depois) só muda o instante do envio e vale sempre,
        // também no que avisou a equipe.
        allow update: if ehTitular(pid) && registroValido()
          && request.resource.data.registradoEm == resource.data.registradoEm
          && (
            (request.resource.data.versao == resource.data.get('versao', 1)
              && soMudam(['enviadoEm']))
            || (podeMudar() && doFormatoAntigo() && !antigoQuePodeTerAlertado()
              && request.resource.data.versao == 1
              && (request.resource.data.get('retiradoEm', null) == null
                || retiradaValida()))
            || (podeMudar() && !doFormatoAntigo() && (
              versaoSeguinte()
              || (request.resource.data.versao == resource.data.versao
                && soMudam(['retiradoEm', 'motivoDaRetirada'])
                && retiradaValida())))
          );
        allow delete: if false;
      }

      // D18: alerta só de registro "Bastante" ou "Muito" (grave ou crítico)
      // confirmado no mesmo lote.
      match /alertas/{aid} {
        allow read: if ehTitular(pid);
        allow create, update: if ehTitular(pid)
          && getAfter(/databases/$(db)/documents/pacientes/$(pid)/registros/$(request.resource.data.registroId))
               .data.intensidadeSintoma in ['grave', 'critico'];
        allow delete: if false;
      }

      // O que o cuidador sabe do alerta: só data e ciência (RNFM05).
      match /avisosCuidador/{aid} {
        allow read: if ehTitular(pid) || ehCuidador(pid);
        allow create, update: if ehTitular(pid)
          && existsAfter(/databases/$(db)/documents/pacientes/$(pid)/alertas/$(aid))
          && request.resource.data.keys().hasOnly(['id', 'emitidoEm', 'cienteEm']);
        allow delete: if false;
      }

      // Evolução de TO (F1, D26): como foi cada atividade de casa no dia. O
      // titular (ou o responsável legal, dono da conta) cria e corrige; a
      // atividade precisa ser deste paciente; nada é apagado (desfazer é
      // lógico, excluidoEm). Corrigir não muda a atividade nem o dia.
      match /registrosCasa/{rid} {
        function registroCasaValido() {
          let d = request.resource.data;
          return d.id == rid
            && d.pacienteId == pid
            && d.situacaoEnvio == 'enviado'
            && d.adesao in ['feito', 'emParte', 'naoFeito']
            && d.quem in ['paciente', 'responsavel']
            && (d.reflexao == null || (d.reflexao is string && d.reflexao.size() <= 500))
            && exists(/databases/$(db)/documents/pacientes/$(pid)/atividadesCasa/$(d.atividadeId));
        }
        allow read: if ehTitular(pid);
        allow create: if ehTitular(pid) && registroCasaValido();
        allow update: if ehTitular(pid) && registroCasaValido()
          && request.resource.data.atividadeId == resource.data.atividadeId
          && request.resource.data.dia == resource.data.dia;
        allow delete: if false;
      }

      // Evolução de TO (F2, D27): a resposta de presença de uma sessão. O
      // titular (ou o responsável legal, dono da conta) responde e pode trocar
      // a resposta; a sessão precisa estar marcada e a resposta ter sido dada
      // antes do horário dela (mesmo que chegue depois, pela fila). O cuidador
      // lê a resposta (D29). Nunca cancela a sessão; nada é apagado.
      //
      // Limitações declaradas (revisão da F2):
      // - o cuidador lê o documento inteiro, com o `respondidaEm`: a regra não
      //   escolhe campos na leitura. O app mostra a ele só a resposta, e
      //   nenhum dos campos é dado clínico;
      // - o `respondidaEm` vem do aparelho (a resposta pode chegar depois,
      //   pela fila). Quem antedatar consegue trocar a resposta depois da
      //   sessão; aceito como na D31.
      match /confirmacoes/{aid} {
        function respostaValida() {
          let d = request.resource.data;
          let sessao = get(/databases/$(db)/documents/pacientes/$(pid)/agendamentos/$(aid)).data;
          return d.id == aid
            && d.agendamentoId == aid
            && d.pacienteId == pid
            && d.situacaoEnvio == 'enviado'
            && d.resposta in ['vamos', 'naoVamos']
            && d.keys().hasOnly(['id', 'agendamentoId', 'pacienteId', 'resposta',
                 'respondidaEm', 'situacaoEnvio'])
            && sessao.situacao == 'agendado'
            && d.respondidaEm is string
            && d.respondidaEm < sessao.dataHora;
        }
        allow read: if ehTitular(pid) || ehCuidador(pid);
        allow create, update: if ehTitular(pid) && respostaValida();
        allow delete: if false;
      }

      // Convites completos (com o CPF) que o titular gerou na TM07.
      match /convites/{cid} {
        allow read: if ehTitular(pid);
        allow create: if ehTitular(pid) && request.resource.data.pacienteId == pid;
        allow update, delete: if false;
      }

      // Cópias completas: só o titular lê; quem grava é a clínica (semente).
      // As metas da TO (F3) também: o cuidador não vê metas (D29).
      match /{colecao}/{id} {
        allow read: if ehTitular(pid)
          && colecao in ['agendamentos', 'receitas', 'itensMedicacao', 'marcos',
            'atividadesCasa', 'metas'];
      }

      // Cópias reduzidas do cuidador (sem motivo do retorno, orientação nem
      // prescritor).
      match /{colecao}/{id} {
        allow read: if (ehTitular(pid) || ehCuidador(pid))
          && colecao in ['agendaCuidador', 'receitaCuidador', 'itensCuidador'];
      }
    }

    // ----------------------------------------------------------- vínculos
    match /vinculos/{vid} {
      allow read: if ehTitular(resource.data.pacienteId);
      allow create: if ehTitular(request.resource.data.pacienteId)
        && request.resource.data.situacao == 'pendente'
        && request.resource.data.contaCuidadorId == null;
      allow update: if
        // Revogar (TM07).
        (ehTitular(resource.data.pacienteId)
          && request.resource.data.situacao == 'revogado'
          && soMudam(['situacao', 'revogadoEm']))
        // Aceitar (TM10): o uid entra em cuidadoresAtivos no mesmo lote.
        || (logado() && resource.data.situacao == 'pendente'
          && request.resource.data.situacao == 'ativo'
          && request.resource.data.contaCuidadorId == uid()
          && soMudam(['situacao', 'contaCuidadorId', 'autorizadoEm'])
          && uid() in pacienteDepois(resource.data.pacienteId).cuidadoresAtivos);
      allow delete: if false;
    }

    // ----------------------------------------------------- consentimentos
    match /consentimentos/{id} {
      allow read: if logado() && resource.data.contaId == uid();
      allow create: if logado()
        && request.resource.data.contaId == uid()
        && pacienteDepois(request.resource.data.pacienteId).contaId == uid();
      allow update, delete: if false;
    }
  }
}
